{
  "manifest_version": 3,
  "name": "YouTube Feed Detoxifier",
  "version": "1.0",
  "description": "A Chrome extension to filter and blur YouTube videos based on user-defined keywords, with real-time recommendations.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.html",
        "overlay.css",
        "overlay.js"
      ],
      "matches": ["*://www.youtube.com/*"]
    }
  ]
}
